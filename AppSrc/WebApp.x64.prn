37752>>>     Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37755>>>        WebSet pbRender of oNewButton to True
37756>>>        WebSet pbRender of oDetailButton to True
37757>>>
37757>>>        Case Begin
37757>>>            Case (NavigateData.eNavigateType = nfFromParent)
37759>>>                // If from parent, this is a constrained drill down
37759>>>                Case Break
37760>>>
37760>>>            Case (NavigateData.eNavigateType = nfFromChild)
37763>>>                // If from child, this is a probably a parent lookup from a Zoom
37763>>>                Case Break
37764>>>
37764>>>            Case (NavigateData.eNavigateType = nfFromMain)
37767>>>                // If from main, this is a probably a main-file lookup from a Zoom
37767>>>                WebSet pbRender of oDetailButton to False
37768>>>                Case Break
37769>>>
37769>>>            Case Else // must be nfUndefined
37769>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37769>>>
37769>>>        Case End
37769>>>
37769>>>    End_Procedure
