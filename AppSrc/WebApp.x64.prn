37994>>>>>>>    Procedure AgregarPosicion String sRowId
37997>>>>>>>        Integer iJugadorId iPosicionId
37997>>>>>>>        Boolean bFound bOk bChanged
37997>>>>>>>        RowID riJugador riPosicion
37997>>>>>>>
37997>>>>>>>        Get Field_Current_Value of ojugador_DD Field jugador.ID to iJugadorId
37998>>>>>>>        Get CurrentRowId of ojugador_DD to riJugador
37999>>>>>>>        Move (DeserializeRowID(sRowId)) to riPosicion
38000>>>>>>>
38000>>>>>>>        If (iJugadorId = 0) Begin
38002>>>>>>>            Send UserError "Guarda el jugador antes de asignar posiciones." "Posiciones"
38003>>>>>>>            Procedure_Return
38004>>>>>>>        End
38004>>>>>>>>
38004>>>>>>>
38004>>>>>>>        If (IsNullRowID(riPosicion)) Begin
38006>>>>>>>            Send UserError "Selecciona una posicion antes de asignarla." "Posiciones"
38007>>>>>>>            Procedure_Return
38008>>>>>>>        End
38008>>>>>>>>
38008>>>>>>>
38008>>>>>>>        Get ChangeCurrentRow of oPosicionesDisponiblesList "row" sRowId to bChanged
38009>>>>>>>        If (not(bChanged)) Begin
38011>>>>>>>            Send UserError "No se pudo seleccionar la posicion para asignarla." "Posiciones"
38012>>>>>>>            Procedure_Return
38013>>>>>>>        End
38013>>>>>>>>
38013>>>>>>>
38013>>>>>>>        Get FindByRowIdEx of ojugador_DD jugador.File_Number riJugador to bOk
38014>>>>>>>        Get FindByRowIdEx of oposicionSave_DD posicion.File_Number riPosicion to bOk
38015>>>>>>>        If (not(bOk)) Begin
38017>>>>>>>            Send UserError "No se encontro la posicion seleccionada." "Posiciones"
38018>>>>>>>            Procedure_Return
38019>>>>>>>        End
38019>>>>>>>>
38019>>>>>>>
38019>>>>>>>        Get Field_Current_Value of oposicionSave_DD Field posicion.ID to iPosicionId
38020>>>>>>>
38020>>>>>>>        Send Clear of ojugadorposicionSave_DD
38021>>>>>>>        Set Field_Changed_Value of ojugadorposicionSave_DD Field jugadorposicion.JugadorID to iJugadorId
38022>>>>>>>        Set Field_Changed_Value of ojugadorposicionSave_DD Field jugadorposicion.PosicionID to iPosicionId
38023>>>>>>>        Send Find of ojugadorposicionSave_DD EQ Index.2
38024>>>>>>>        Move (Found) to bFound
38025>>>>>>>
38025>>>>>>>        If (bFound) Begin
38027>>>>>>>            Send UserError "El jugador ya tiene asignada esa posicion." "Posiciones"
38028>>>>>>>            Send Clear of ojugadorposicionSave_DD
38029>>>>>>>            Send RefrescarListasJugador riJugador
38030>>>>>>>            Procedure_Return
38031>>>>>>>        End
38031>>>>>>>>
38031>>>>>>>
38031>>>>>>>        Send Clear of ojugadorposicionSave_DD
38032>>>>>>>        Get FindByRowIdEx of ojugador_DD jugador.File_Number riJugador to bOk
38033>>>>>>>        Get FindByRowIdEx of oposicionSave_DD posicion.File_Number riPosicion to bOk
38034>>>>>>>        Set Field_Changed_Value of ojugadorposicionSave_DD Field jugadorposicion.JugadorID to iJugadorId
38035>>>>>>>        Set Field_Changed_Value of ojugadorposicionSave_DD Field jugadorposicion.PosicionID to iPosicionId
38036>>>>>>>        Send Request_Assign of ojugadorposicionSave_DD jugador.File_Number
38037>>>>>>>        Send Request_Assign of ojugadorposicionSave_DD posicion.File_Number
38038>>>>>>>        Send Request_Save of ojugadorposicionSave_DD
38039>>>>>>>        Send Clear of ojugadorposicionSave_DD
38040>>>>>>>        Send RefrescarListasJugador riJugador
38041>>>>>>>    End_Procedure
