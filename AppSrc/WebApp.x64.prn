38413>>>        Get HasRecord of hoDD to bHasRecord
38414>>>
38414>>>        // let's hide all buttons and then Show the ones we want
38414>>>        WebSet pbRender of oEditBtn to False
38415>>>        WebSet pbRender of oSaveBtn to True
38416>>>        WebSet pbRender of oCancelChangesBtn to False
38417>>>        WebSet pbRender of oDeleteBtn to False
38418>>>
38418>>>        If (NavigateData.bReadOnly) Begin
38420>>>            WebSet pbRender of oEditBtn to True
38421>>>        End
38421>>>>
