38409>>>>>    Procedure AgregarPosicion String sRowId
38412>>>>>        Integer iJugadorId iPosicionId
38412>>>>>        Boolean bFound
38412>>>>>        RowID riPosicion
38412>>>>>
38412>>>>>        Move jugador.ID to iJugadorId
38413>>>>>        Move (DeserializeRowID(sRowId)) to riPosicion
38414>>>>>        Send ReadByRowId of oposicion_DD posicion.File_Number riPosicion
38415>>>>>        Move posicion.ID to iPosicionId
38416>>>>>
38416>>>>>        If (iJugadorId = 0) Begin
38418>>>>>            Send UserError "Guarda el jugador antes de asignar posiciones." "Posiciones"
38419>>>>>            Procedure_Return
38420>>>>>        End
38420>>>>>>
38420>>>>>
38420>>>>>        If (iPosicionId = 0) Begin
38422>>>>>            Send UserError "Selecciona una posicion antes de asignarla." "Posiciones"
38423>>>>>            Procedure_Return
38424>>>>>        End
38424>>>>>>
38424>>>>>
38424>>>>>        Send Clear of ojugadorposicion_DD
38425>>>>>        Set Field_Changed_Value of ojugadorposicion_DD Field jugadorposicion.JugadorID to iJugadorId
38426>>>>>        Set Field_Changed_Value of ojugadorposicion_DD Field jugadorposicion.PosicionID to iPosicionId
38427>>>>>        Send Find of ojugadorposicion_DD EQ Index.2
38428>>>>>        Move (Found) to bFound
38429>>>>>
38429>>>>>        If (bFound) Begin
38431>>>>>            Send UserError "El jugador ya tiene asignada esa posicion." "Posiciones"
38432>>>>>            Send Clear of ojugadorposicion_DD
38433>>>>>            Send GridRefresh of oPosicionesList
38434>>>>>            Procedure_Return
38435>>>>>        End
38435>>>>>>
38435>>>>>
38435>>>>>        Send Clear of ojugadorposicion_DD
38436>>>>>        Set Field_Changed_Value of ojugadorposicion_DD Field jugadorposicion.JugadorID to iJugadorId
38437>>>>>        Set Field_Changed_Value of ojugadorposicion_DD Field jugadorposicion.PosicionID to iPosicionId
38438>>>>>        Send Request_Save of ojugadorposicion_DD
38439>>>>>        Send Clear of ojugadorposicion_DD
38440>>>>>        Send GridRefresh of oPosicionesDisponiblesList
38441>>>>>        Send GridRefresh of oPosicionesList
38442>>>>>    End_Procedure
38443>>>>>
38443>>>>>    Procedure QuitarPosicion String sRowId
38446>>>>>        Boolean bRowChanged
38446>>>>>
38446>>>>>        Get ChangeCurrentRow of oPosicionesList "row" sRowId to bRowChanged
38447>>>>>        If (not(bRowChanged)) Begin
38449>>>>>            Send UserError "No se pudo seleccionar la posicion para quitarla." "Posiciones"
38450>>>>>            Procedure_Return
38451>>>>>        End
38451>>>>>>
38451>>>>>
38451>>>>>        Send Request_Delete of ojugadorposicion_DD
38452>>>>>
38452>>>>>        Send GridRefresh of oPosicionesDisponiblesList
38453>>>>>        Send GridRefresh of oPosicionesList
38454>>>>>    End_Procedure
