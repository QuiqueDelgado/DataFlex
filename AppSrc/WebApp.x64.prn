39106>>>>>        WebSet pbRender of oEditBtn to False
39107>>>>>        WebSet pbRender of oSaveBtn to False
39108>>>>>        WebSet pbRender of oCancelChangesBtn to False
39109>>>>>        WebSet pbRender of oDeleteBtn to False
39110>>>>>
39110>>>>>        If (NavigateData.bReadOnly) Begin
39112>>>>>            WebSet pbRender of oEditBtn to True
39113>>>>>        End
39113>>>>>>
39113>>>>>        Else Begin
39114>>>>>            WebSet pbRender of oSaveBtn to True
39115>>>>>            WebSet pbRender of oCancelChangesBtn to True
39116>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39117>>>>>        End
39117>>>>>>
39117>>>>>    End_Procedure
